{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm ci --prefix mobile --no-audit --no-fund && npm run --prefix mobile build:hosting",
  "headers": [
    {
      "source": "/photo-library/:city/:scene/immersive-blur/photo.jpg",
      "has": [{ "type": "query", "key": "v", "value": "[a-f0-9]{12}" }],
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
